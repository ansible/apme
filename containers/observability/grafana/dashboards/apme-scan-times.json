        "defaults": { "unit": "s", "custom": { "spanNulls": true } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(apme_scan_phase_duration_seconds_bucket[5m])) by (le, phase))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
