{
  "name": "apme-ui-workspaces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "frontend/packages/*",
    "frontend/backstage/plugins/*",
    "containers/rhdh/plugin"
  ],
  "scripts": {
    "build": "npm run build -w @apme/client && npm run build -w @apme/ui-workflow && npm run build -w @apme/backstage-plugin && npm run build -w @apme/backstage-plugin-backend",
    "typecheck": "tsc --noEmit -p frontend/backstage/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "lint:ui": "node frontend/backstage/scripts/check-eslint-minimatch.mjs && eslint . --ext .ts,.tsx",
    "test": "vitest run --config frontend/backstage/vite.config.ts --maxWorkers=2",
    "pack": "node frontend/backstage/scripts/pack.mjs",
    "format": "prettier --write eslint.config.mjs frontend/backstage frontend/portal frontend/packages/apme-client containers/rhdh tsconfig.json",
    "format:check": "prettier --check eslint.config.mjs frontend/backstage frontend/portal frontend/packages/apme-client containers/rhdh tsconfig.json",
    "pack:verify": "node frontend/backstage/scripts/verify-pack.mjs",
    "pack:verify:release": "node frontend/backstage/scripts/verify-release-pack.mjs",
    "dev": "vite --config frontend/backstage/vite.config.ts --host 127.0.0.1",
    "build:dev": "vite build --config frontend/backstage/vite.config.ts"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/config": "1.3.8",
    "@backstage/core-app-api": "1.20.4",
    "@backstage/core-plugin-api": "1.12.9",
    "@backstage/ui": "0.17.1",
    "@patternfly/react-core": "6.6.2",
    "@patternfly/react-icons": "6.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@backstage/config-loader": "1.10.12",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-a11y": "1.4.0",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@red-hat-developer-hub/cli": "2.1.2"
  },
  "overrides": {
    "minimatch@^10.0.1": "11.0.1",
    "minimatch@^10.2.2": "11.0.1",
    "minimatch@^10.2.4": "11.0.1",
    "minimatch@^10.2.6": "11.0.1",
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    },
    "@red-hat-developer-hub/cli": {
      "@backstage/cli-module-auth": "0.1.5",
      "@backstage/cli-module-new": "0.1.8"
    }
  }
}
