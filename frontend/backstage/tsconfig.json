{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vitest/globals", "vite/client"],
    "paths": {
      "@apme/client": ["../packages/apme-client/src/index.ts"],
      "@apme/client/*": ["../packages/apme-client/src/*"],
      "@apme/ui-workflow": ["../packages/ui-workflow/src/index.ts"],
      "@apme/ui-workflow/headless": ["../packages/ui-workflow/src/headless.ts"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"],
      "typescript": ["../../node_modules/typescript"],
      "@apme/ui-workflow/graph": ["../packages/ui-workflow/src/graph/index.ts"],
      "@apme/backstage-plugin/host-api": [
        "./plugins/backstage-apme/src/api/apmeApi.ts"
      ],
      "@apme/backstage-plugin/page": [
        "./plugins/backstage-apme/src/components/ApmePage.tsx"
      ],
      "@apme/backstage-plugin/settings": [
        "./plugins/backstage-apme/src/components/ApmeSettings.tsx"
      ]
    }
  },
  "include": [
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "dev",
    "tests",
    "vite.config.ts"
  ]
}
