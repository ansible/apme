{
  "name": "@apme/ui-workflow",
  "version": "0.0.0-dev",
  "type": "module",
  "description": "APME check and remediation workflow presentation for BUI hosts, with a headless controller entry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansible/apme.git",
    "directory": "frontend/packages/ui-workflow"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/workflow.css": "./dist/styles/workflow.css",
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/styles dist/graph && cp src/styles/workflow.css dist/styles/workflow.css && cp src/graph/apme.svg dist/graph/apme.svg",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@backstage/ui": "^0.17.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "^5.9.3",
    "@types/prismjs": "^1.26.5",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.52"
  },
  "dependencies": {
    "@apme/client": "*",
    "prismjs": "^1.30.0",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "@remixicon/react": ">=4.6.0 <4.9.0"
  }
}
