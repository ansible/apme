{
  "name": "@apme/client",
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Host-independent APME Gateway public API client and transport.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansible/apme.git",
    "directory": "frontend/packages/apme-client"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
