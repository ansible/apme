{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@apme/ui-workflow": [
        "./packages/ui-workflow/src/index.ts"
      ],
      "@apme/client": [
        "./packages/apme-client/src/index.ts"
      ],
      "@apme/client/*": [
        "./packages/apme-client/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@apme/ui-workflow/graph": [
        "./packages/ui-workflow/src/graph/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/ui-workflow/src",
    "packages/apme-client/src"
  ],
  "exclude": [
    "vendor"
  ]
}
