# ============================================================================
# APME Environment Variables Example
# ============================================================================
#
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control!
#
# ============================================================================

# ============================================================================
# ENGINE SERVICE
# ============================================================================

APME_ENGINE_LISTEN=0.0.0.0:50051

# Validator addresses (within pod, use localhost)
NATIVE_GRPC_ADDRESS=127.0.0.1:50055
OPA_GRPC_ADDRESS=127.0.0.1:50054
ANSIBLE_GRPC_ADDRESS=127.0.0.1:50053
GITLEAKS_GRPC_ADDRESS=127.0.0.1:50056

# Concurrency limits
APME_ENGINE_MAX_RPCS=16

# ============================================================================
# NATIVE VALIDATOR
# ============================================================================

APME_NATIVE_VALIDATOR_LISTEN=0.0.0.0:50055
APME_NATIVE_MAX_RPCS=32

# ============================================================================
# OPA VALIDATOR
# ============================================================================

APME_OPA_VALIDATOR_LISTEN=0.0.0.0:50054
APME_OPA_MAX_RPCS=32

# OPA internal REST (not typically changed)
# OPA_REST_ADDRESS=localhost:8181

# ============================================================================
# ANSIBLE VALIDATOR
# ============================================================================

APME_ANSIBLE_VALIDATOR_LISTEN=0.0.0.0:50053
APME_ANSIBLE_MAX_RPCS=8

# Default ansible-core version if not specified in request
# APME_DEFAULT_ANSIBLE_VERSION=2.18

# ============================================================================
# GITLEAKS VALIDATOR
# ============================================================================

APME_GITLEAKS_VALIDATOR_LISTEN=0.0.0.0:50056
APME_GITLEAKS_MAX_RPCS=16

# ============================================================================
# GALAXY PROXY (collection-to-wheel bridge)
# ============================================================================

# URL of the galaxy-proxy sidecar (PEP 503 Simple Repository API).
# VenvSessionManager installs collections via uv pip install --extra-index-url
# through this proxy. The proxy converts Galaxy tarballs to pip-installable wheels.
APME_GALAXY_PROXY_URL=http://127.0.0.1:8765

# GitHub token for org cloning (optional, for private repos — future feature)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Admin token for Galaxy Proxy /admin/* endpoints (PEP 503 bridge).
# When set, the proxy requires `x-apme-proxy-token` on admin routes and the
# Gateway presents it when pushing galaxy-config. When unset, admin routes are
# open (local-dev default) and the proxy logs a startup warning.
# Rollout: set the same token on the proxy first, then on the gateway —
# mixed versions fail closed with 403 while the envs disagree.
# POST /convert-tarballs is operator-only (no in-repo production caller).
# APME_PROXY_ADMIN_TOKEN=change-me-to-a-long-random-value

# ============================================================================
# SESSION HARDENING (Engine admission + upload caps)
# ============================================================================

# Cooldown before the OPA circuit breaker allows a trial eval after
# latching on consecutive timeouts (seconds)
# APME_OPA_BREAKER_COOLDOWN=300

# Minimum interval between FixSession creations, per daemon process.
# Opt-in burst protection for unauthenticated clients (default 0/disabled).
# APME_SESSION_MIN_CREATE_INTERVAL_S=0

# Cap on concurrent pip/galaxy venv builds across sessions
# APME_SESSION_MAX_CONCURRENT_VENV_BUILDS=3

# Bound on waiting for a venv build slot before failing fast (seconds).
# Hung pip/galaxy builds must not starve warm-hit scans indefinitely.
# APME_SESSION_VENV_BUILD_WAIT_S=600

# Per-session aggregate upload caps (FixSession stream)
# APME_SESSION_MAX_UPLOAD_BYTES=268435456
# APME_SESSION_MAX_UPLOAD_FILES=2000

# Cap on distinct sibling venvs per session (ansible-version spread)
# APME_SESSION_MAX_VENVS_PER_SESSION=8

# ============================================================================
# GATEWAY OPERATION TIMEOUTS (operator-prompt waits)
# ============================================================================

# How long the gateway waits for an operator answer before falling back
# to the no-queue defaults (begin: auto-begin, escalate: allow-all,
# approve: decline-all). Seconds.
# APME_OP_BEGIN_TIMEOUT_S=600
# APME_OP_ESCALATE_TIMEOUT_S=600
# APME_OP_APPROVE_TIMEOUT_S=1800

# ============================================================================
# CLI (local development)
# ============================================================================

# Engine address for CLI to connect to
# APME_ENGINE_ADDRESS=127.0.0.1:50051

# OPA mode (podman or local binary)
# OPA_USE_PODMAN=1

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
APME_LOG_LEVEL=INFO

# Structured logging format: json, console
APME_LOG_FORMAT=console

# ============================================================================
# AI REMEDIATION (Future - DR-005)
# ============================================================================

# LLM provider: none, anthropic, openai, ollama
# APME_LLM_PROVIDER=none

# API keys (if using external providers)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# Ollama endpoint (if using local models)
# OLLAMA_HOST=http://localhost:11434

# ============================================================================
# DATABASE (Gateway persistence)
# ============================================================================

# PostgreSQL URL for scan result persistence (required for Gateway)
# APME_DATABASE_URL=postgresql+asyncpg://apme:apme@localhost:5432/apme
